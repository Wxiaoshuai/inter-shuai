# App settings
APP_NAME="AI RAG & Agent Service"
DEBUG=false

# Milvus settings
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=default_collection

# DeepSeek LLM settings
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 阿里云百炼 Embedding settings
BAILIAN_API_KEY=your_bailian_api_key_here
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_EMBEDDING_MODEL=text-embedding-3-large

# RAG settings
CHUNK_SIZE=500
CHUNK_OVERLAP=50
SEARCH_K=3

# Agent settings
MAX_ITERATIONS=10
AGENT_TIMEOUT=300

# MySQL settings (for permanent storage)
MYSQL_HOST=192.168.1.33
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=ai_memory

# Memory settings
SHORT_TERM_MAX_MESSAGES=20
LONG_TERM_MEMORY_ENABLED=true